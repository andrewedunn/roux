// Cloudflare Worker config for roux.dunn.us (slug: roux).
{
  "name": "roux",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/"]
  },
  "routes": [{ "pattern": "roux.dunn.us", "custom_domain": true }],
  "observability": { "enabled": true }
}
