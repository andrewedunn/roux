// Cloudflare Worker config for the Crystal Hot Sauce partner edition (crystal-roux.dunn.us), built from the
// crystal branch. The live game (roux.dunn.us, Worker "roux") is deployed from main and is untouched by this.
{
  "name": "roux-crystal",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "."
  },
  "routes": [{ "pattern": "crystal-roux.dunn.us", "custom_domain": true }]
}
